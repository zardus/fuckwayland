  kde) comp=kwin_wayland ;; kde-x11) comp=kwin_x11 ;;
  xfce|xfce-wayland) comp=xfce4-session ;;
  lxqt|lxqt-wayland) comp=lxqt-session ;;
  sway) comp=sway ;; hypr) comp=Hyprland ;; wayfire) comp=wayfire ;; river) comp=river ;;
  cosmic) comp=cosmic-comp ;; labwc|budgie) comp=labwc ;;
