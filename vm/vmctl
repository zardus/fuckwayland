fi
# XDG_SESSION_ID is not in the user manager's environment: logind's "display"
# session of the user (the graphical one), else the user's session on a seat.
if [ -z "$XDG_SESSION_ID" ]; then
  sid=$(loginctl show-user "$(id -un)" -p Display --value 2>/dev/null)
  if [ -z "$sid" ] || [ -z "$(loginctl show-session "$sid" -p Seat --value 2>/dev/null)" ]; then
    for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$(id -un)" '$3==u {print $1}'); do
      [ -n "$(loginctl show-session "$s" -p Seat --value 2>/dev/null)" ] && { sid=$s; break; }
    done
  fi
  case "$sid" in *[!A-Za-z0-9_.-]*|"") ;; *) export XDG_SESSION_ID=$sid ;; esac
fi
# XDG_SESSION_TYPE: what the session exported (GNOME/Plasma/Xfce: the same as
# logind's Type; sway publishes wayland although greetd registered a tty
# session), else logind's Type, else the kind of session the flavor runs.
case "$XDG_SESSION_TYPE" in wayland|x11) ;; *) unset XDG_SESSION_TYPE ;; esac
if [ -z "$XDG_SESSION_TYPE" ] && [ -n "$XDG_SESSION_ID" ]; then
  st=$(loginctl show-session "$XDG_SESSION_ID" -p Type --value 2>/dev/null)
  case "$st" in wayland|x11) export XDG_SESSION_TYPE=$st ;; esac
fi
: "${XDG_SESSION_TYPE:=$VMCTL_SESSION}"; export XDG_SESSION_TYPE
unset VMCTL_SESSION VMCTL_DESKTOP comp p s st sid RT kv k have
cd "$HOME" 2>/dev/null
exec "$@"
"""


def user_argv(inst, cmd):
    """The remote argv running `cmd` (a list) as user test inside the desktop
    session, with the session environment USER_WRAPPER reconstructs."""
    return ["sudo", "-u", "test", "-H", "env",
            "XDG_RUNTIME_DIR=/run/user/1000",
            "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus",
            "USER=test", "LOGNAME=test",
            f"VMCTL_SESSION={inst.session_kind()}", f"VMCTL_DESKTOP={inst.desktop()}",
            "sh", "-c", USER_WRAPPER, "vmctl-user"] + list(cmd)


def user_shell(inst, script, timeout=60):
    """Run a /bin/sh script as user test inside the desktop session (what
    `vmctl user` gives a command); returns the CompletedProcess."""
    return run(ssh_cmd(inst.port, 5) + [shlex.join(user_argv(inst, ["sh", "-c", script]))],
               check=False, timeout=timeout)


def cmd_user(a):
    inst = Instance(a.name).require_running()
    # argparse.REMAINDER swallows everything after <name>, including -t and --
    while a.cmd and a.cmd[0] in ("-t", "--tty"):
        a.tty = True
        a.cmd.pop(0)
    if a.cmd and a.cmd[0] == "--":
        a.cmd.pop(0)
    if not a.cmd:
        raise Fail("usage: vmctl user <name> [-t] -- cmd...")
    # The X side needs more than DISPLAY: mutter's/kwin's Xwayland use an auth
    # file (XAUTHORITY=/run/user/1000/.mutter-Xwaylandauth.* / xauth_*) that the
    # session exports to the systemd user manager -- the wrapper imports those
    # plain-valued variables from there, then from the compositor's environ,
    # then falls back to the sockets present (see USER_WRAPPER).
    os.execvp("ssh", ssh_cmd(inst.port, 5, tty=a.tty)
              + [shlex.join(user_argv(inst, a.cmd))])


# ---------------------------------------------------------------- main

def main(argv=None):
    ap = argparse.ArgumentParser(prog="vmctl", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", metavar="COMMAND", required=True)

    p = sub.add_parser("build", help="build the golden image of a flavor (vm/flavors/<flavor>.yaml)")
    p.add_argument("flavor")
    p.add_argument("--cpus", type=int, default=4)
    p.add_argument("--mem", default="6G", type=parse_mem)
    p.add_argument("--size", default="30G", help="overlay disk size (default 30G)")
    p.add_argument("--timeout", type=int, default=3600, help="seconds before the build is killed")
    p.add_argument("--force", action="store_true", help="replace an existing golden image")
    p.add_argument("--keep", action="store_true", help="keep the build dir after success")
    p.set_defaults(fn=cmd_build)

    p = sub.add_parser("start", help="create/reuse an instance and boot it")
    p.add_argument("name")
    p.add_argument("--flavor", help="golden image to use (required for a new instance)")
    p.add_argument("--heads", type=int, default=None, help=f"number of monitors, 1..{MAX_HEADS} (default 1)")
    p.add_argument("--head-size", default=None, metavar="WxH",
                   help=f"size of every head 0..N-1 (default {DEFAULT_HEAD}); implies re-sizing a reused instance")
    p.add_argument("--mem", default=None, help="QEMU memory (default 4G)")
    p.add_argument("--cpus", type=int, default=None, help="vCPUs (default 3)")
    p.add_argument("--fresh", action="store_true", help="recreate the overlay disk and cloud-init seed")
    p.add_argument("--timeout", type=int, default=240, help="seconds to wait for ssh")
    p.add_argument("--no-wait", action="store_true", help="return right after the heads are set, without waiting for ssh")
    p.set_defaults(fn=cmd_start)

    p = sub.add_parser("stop", help="power the guest off (ssh poweroff, ACPI, then kill)")
    p.add_argument("name")
    p.add_argument("--timeout", type=int, default=60)
    p.set_defaults(fn=cmd_stop)

    p = sub.add_parser("destroy", help="stop and delete an instance")
    p.add_argument("name")
    p.set_defaults(fn=cmd_destroy)

    sub.add_parser("list", help="list instances").set_defaults(fn=cmd_list)

    sub.add_parser("flavors", help="list vm/flavors/*.yaml with their distro, desktop and build kind"
                   ).set_defaults(fn=cmd_flavors)

    p = sub.add_parser("status", help="show one instance, including QEMU's console sizes")
    p.add_argument("name")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("ssh", help="ssh as root into the guest: vmctl ssh <name> [-- cmd...]")
    p.add_argument("name")
    p.add_argument("cmd", nargs="*")
    p.set_defaults(fn=cmd_ssh)

    p = sub.add_parser("scp", help="scp to/from the guest; write the guest side as <name>:<path>")
    p.add_argument("name")
    p.add_argument("args", nargs="+")
    p.set_defaults(fn=cmd_scp)

    p = sub.add_parser("head", help="resize/plug/unplug a head: vmctl head <name> <idx> <WxH>|off")
    p.add_argument("name")
    p.add_argument("idx", type=int, help="0-based head index (0 = Virtual-1)")
    p.add_argument("size", help="WIDTHxHEIGHT or off")
    p.set_defaults(fn=cmd_head)

    p = sub.add_parser("heads", help="list guest DRM connectors after a re-probe")
    p.add_argument("name")
    p.set_defaults(fn=cmd_heads)

    p = sub.add_parser("shot", help="QMP screendump: vmctl shot <name> <idx> out.png | vmctl shot <name> --all out")
    p.add_argument("name")
    p.add_argument("idx", nargs="?", type=int)
    p.add_argument("out")
    p.add_argument("--all", action="store_true", help="every active head -> <out>-<idx>.png")
    p.set_defaults(fn=cmd_shot)

    p = sub.add_parser("session", help="wait for user test's graphical session and print its env")
    p.add_argument("name")
    p.add_argument("--timeout", type=int, default=180)
    p.add_argument("--no-paint", action="store_true",
                   help="do not wait for the desktop's first frame")
    p.set_defaults(fn=cmd_session)

    p = sub.add_parser("user", help="run a command in the guest as user test with the session env")
    p.add_argument("name")
    p.add_argument("-t", "--tty", action="store_true", help="allocate a tty (may also follow <name>)")
    p.add_argument("cmd", nargs=argparse.REMAINDER)
    p.set_defaults(fn=cmd_user)

    a = ap.parse_args(argv)
    try:
        a.fn(a)
    except Fail as e:
        print(f"vmctl: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
