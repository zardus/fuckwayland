def cmd_shot(a):
    inst = Instance(a.name).require_running()
    out = Path(a.out).expanduser()
    if a.all:
        if a.idx is not None:
            raise Fail("give either <idx> or --all")
        idxs = inst.active_heads()
        stem = out.with_suffix("") if out.suffix.lower() == ".png" else out
        targets = [(i, stem.parent / f"{stem.name}-{i}.png") for i in idxs]
    else:
        if a.idx is None:
            raise Fail("head index required (or --all)")
        targets = [(a.idx, out)]
    for idx, path in targets:
        path.parent.mkdir(parents=True, exist_ok=True)
        path = path.resolve()
        qmp(inst.qmp_sock, "screendump",
            {"filename": str(path), "device": GPU, "head": idx, "format": "png"}, timeout=30)
        if not path.exists() or path.stat().st_size == 0:
            raise Fail(f"screendump of head {idx} produced no file at {path}")
        print(path)


