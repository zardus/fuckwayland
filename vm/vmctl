def cmd_head(a):
    inst = Instance(a.name).require_running()
    if not 0 <= a.idx < MAX_HEADS:
        raise Fail(f"head index must be 0..{MAX_HEADS - 1}")
    heads = inst.heads()
    if a.size == "off":
        if a.idx == 0:
            raise Fail("head 0 (Virtual-1) is always connected; it can only be resized")
        set_ui_info(inst.bus, a.idx, 0, 0)
        heads[a.idx] = "off"
        log(f"{inst.name}: head {a.idx} (Virtual-{a.idx + 1}) unplugged")
        if inst.session_kind() == "x11":
            drop_x11_output(inst, a.idx)
    else:
        w, h = parse_size(a.size)
