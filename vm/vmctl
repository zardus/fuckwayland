# /proc/<pid>/environ carries XDG_SESSION_TYPE=tty and neither WAYLAND_DISPLAY nor the
# instance signature, while `systemctl --user show-environment` carries both, because
# Hyprland exports them itself [recon2/hyprland, recon2/arch].
