def make_seed(dir_, user_data, instance_id, hostname):
    need_tools("cloud-localds")
    (dir_ / "user-data").write_text(user_data)
    (dir_ / "meta-data").write_text(f"instance-id: {instance_id}\nlocal-hostname: {hostname}\n")
    run(["cloud-localds", str(dir_ / "seed.img"), str(dir_ / "user-data"), str(dir_ / "meta-data")])
    return dir_ / "seed.img"


def qemu_common(mem, cpus, disk, seed, port, serial, pidfile, name):
    return ["qemu-system-x86_64", "-name", name, "-enable-kvm", "-cpu", "host",
            "-m", mem, "-smp", str(cpus), "-daemonize", "-pidfile", str(pidfile),
            "-drive", f"file={disk},if=virtio,format=qcow2",
            "-drive", f"file={seed},if=virtio,format=raw,readonly=on",
            "-device", "virtio-rng-pci",
            "-netdev", f"user,id=n0,hostfwd=tcp:127.0.0.1:{port}-:22",
            "-device", "virtio-net-pci,netdev=n0",
            "-serial", f"file:{serial}"]


# ---------------------------------------------------------------- build

def flavor_file(flavor):
    f = FLAVORS / f"{flavor}.yaml"
    if not f.exists():
        have = ", ".join(sorted(p.stem for p in FLAVORS.glob("*.yaml"))) or "none"
        raise Fail(f"unknown flavor {flavor!r}; available: {have}")
    return f


def flavor_header(flavor, key):
    """A `# vmctl-<key>: <value>` header of the flavor yaml, or None.

    One idiom for every header, shared verbatim with vm/selftest.sh,
    vm/live-smoke.sh and scripts/ci-golden.sh, which read the same lines with
    `sed -n 's/^#[[:space:]]*vmctl-<key>:...`."""
    m = re.search(rf"^#\s*vmctl-{key}:\s*(\S+)", flavor_file(flavor).read_text(), re.M)
    return m[1] if m else None


def flavor_iso(flavor):
    """The flavor's `# vmctl-iso: <image.iso>` header, or None for a cloud-image flavor."""
    return flavor_header(flavor, "iso")


def flavor_nix(flavor):
    """The flavor's `# vmctl-nix: <nixosConfigurations attr>` header, or None.

    A third build kind beside -base and -iso: NixOS publishes no cloud image at all
    (the 26.05 release directory carries two ISOs and nothing else), so the image is
    built from `config.system.build.images.qemu` [recon2/nixos]."""
    return flavor_header(flavor, "nix")


DISTROS = ("ubuntu", "fedora", "arch", "nixos")


def flavor_distro(flavor):
    """The flavor's `# vmctl-distro:` header (default ubuntu).

    What the HOST side needs: which package-list shape to expect, which host to wait
    for, which display-manager unit the hint names.  The guest never reads it -- the
    embedded build script derives the manager from /etc/os-release ID -- so the yaml
    cannot lie to the guest about what it is."""
    d = flavor_header(flavor, "distro") or "ubuntu"
    if d not in DISTROS:
        raise Fail(f"{flavor_file(flavor)}: unknown '# vmctl-distro: {d}' (want {'|'.join(DISTROS)})")
    return d


def flavor_ci(flavor):
    """The flavor's `# vmctl-ci: push|on-demand` header (default push), read by CI's
    plan job to split the matrix."""
    c = flavor_header(flavor, "ci") or "push"
    if c not in ("push", "on-demand"):
        raise Fail(f"{flavor_file(flavor)}: unknown '# vmctl-ci: {c}' (want push|on-demand)")
    return c


def flavor_base_sha256(flavor):
    """The flavor's `# vmctl-base-sha256:` header, or None: what scripts/ci-golden.sh
    checks a downloaded base image against."""
    h = flavor_header(flavor, "base-sha256")
    if h is not None and not re.fullmatch(r"[0-9a-f]{64}", h):
        raise Fail(f"{flavor_file(flavor)}: '# vmctl-base-sha256: {h}' is not 64 hex digits")
    return h


def flavor_base(flavor):
    text = flavor_file(flavor).read_text()
    m = re.search(r"^#\s*vmctl-base:\s*(\S+)", text, re.M)
    if not m:
        if flavor_nix(flavor):
            # NixOS is not "a cloud image plus a metapackage": the image is a build
            # product of the flavor's own module, root key baked in, and the cloud-init
            # seed is ignored entirely [recon2/nixos].
            raise Fail(f"{flavor} is a NixOS flavor (built from the nixosConfigurations attr "
                       f"{flavor_nix(flavor)}, not from a cloud image): build it with "
                       f"vm/build-nixos-golden.sh {flavor}")
        if flavor_iso(flavor):
            # An ISO flavor is not built from a cloud image at all: the real Ubuntu
            # desktop installer installs it off the release ISO (see vm/README.md).
            raise Fail(f"{flavor} is an ISO flavor (installed from {flavor_iso(flavor)} by the "
                       f"Ubuntu installer itself, not from a cloud image): build it with "
                       f"vm/build-iso-golden.sh {flavor}")
        raise Fail(f"{flavor_file(flavor)}: missing '# vmctl-base: <image>' header")
    base = Path(m[1]).expanduser()
    if not base.is_absolute():
        base = IMAGES / base
    if not base.exists():
        raise Fail(f"base image {base} not found (set VMIMAGES or download it)")
    return base.resolve()


def flavor_desktop(flavor):
    """The flavor's `# vmctl-desktop:` header (default gnome); one of DESKTOPS' keys."""
    d = flavor_header(flavor, "desktop") or "gnome"
    if d not in DESKTOPS:
        raise Fail(f"{flavor_file(flavor)}: unknown '# vmctl-desktop: {d}' (want {'|'.join(DESKTOPS)})")
    return d


def golden_path(flavor):
    return GOLDEN / f"{flavor}.qcow2"


def render_flavor(flavor):
    """Flavor yaml with @@ROOT_PUBKEY@@ and the (indented) @@BUILD_SCRIPT@@ filled in."""
    text = flavor_file(flavor).read_text()
    if not BUILD_SCRIPT.exists():
        raise Fail(f"{BUILD_SCRIPT} missing")
    script = BUILD_SCRIPT.read_text().rstrip("\n").split("\n")
    out = []
    for line in text.split("\n"):
        if line.strip() == "@@BUILD_SCRIPT@@":
            indent = line[: len(line) - len(line.lstrip())]
            out.extend((indent + s) if s else "" for s in script)
        else:
            out.append(line.replace("@@ROOT_PUBKEY@@", root_pubkey()))
    return "\n".join(out)


def tail_file(path, n=25):
    try:
        lines = Path(path).read_text(errors="replace").replace("\r", "").splitlines()
    except OSError:
        return ""
    return "\n".join(lines[-n:])


def cmd_build(a):
    need_tools("qemu-system-x86_64", "qemu-img", "cloud-localds")
    flavor = a.flavor
    base = flavor_base(flavor)   # raises and points at build-iso-golden.sh for an ISO flavor
    golden = golden_path(flavor)
    if golden.exists() and not a.force:
        raise Fail(f"{golden} exists; use --force to rebuild (instances based on it would break)")
    bdir = BUILDS / flavor
    if bdir.exists():
        pid = read_pid(bdir / "qemu.pid")
        if pid and pid_alive(pid):
            raise Fail(f"a build of {flavor} is already running (pid {pid}, {bdir})")
        shutil.rmtree(bdir)
    bdir.mkdir(parents=True)
    GOLDEN.mkdir(parents=True, exist_ok=True)
    with port_lock():
        port = alloc_port()
        (bdir / "meta.json").write_text(json.dumps({"port": port, "flavor": flavor, "build": True}) + "\n")
    disk = bdir / "disk.qcow2"
    run(["qemu-img", "create", "-q", "-f", "qcow2", "-F", "qcow2", "-b", str(base), str(disk), a.size])
    seed = make_seed(bdir, render_flavor(flavor), f"{flavor}-golden", flavor)
    serial = bdir / "serial.log"
    pidfile = bdir / "qemu.pid"
    cmd = qemu_common(a.mem, a.cpus, disk, seed, port, serial, pidfile, f"build-{flavor}") + ["-display", "none"]
    t0 = time.monotonic()
    log(f"build {flavor}: base {base.name}, {a.cpus} vCPU/{a.mem}, ssh 127.0.0.1:{port} (root, debugging only)")
    run(cmd, capture=False)
    pid = read_pid(pidfile)
    if not pid:
        raise Fail("QEMU did not write its pidfile")
    log(f"build {flavor}: QEMU pid {pid}; serial log {serial}")
    offset = 0
    ok = False
    try:
        while True:
            alive = pid_alive(pid)
            try:
                with open(serial, "rb") as f:
                    f.seek(offset)
                    chunk = f.read()
                    offset += len(chunk)
            except OSError:
                chunk = b""
            for line in chunk.decode(errors="replace").replace("\r", "").splitlines():
                if line.startswith("vmctl-build:"):
                    log(f"[{int(time.monotonic() - t0):4d}s] {line}")
            if not alive:
                break
            if time.monotonic() - t0 > a.timeout:
                log(f"build {flavor}: timed out after {a.timeout}s, killing QEMU")
                kill_pid(pid)
                raise Fail(f"build {flavor} timed out; serial log tail:\n{tail_file(serial)}")
            time.sleep(5)
        text = serial.read_text(errors="replace").replace("\r", "")
        if "VMCTL-BUILD-OK" not in text:
            raise Fail(f"build {flavor}: no VMCTL-BUILD-OK marker in {serial}; tail:\n{tail_file(serial, 40)}")
        m = re.search(r"VMCTL-PACKAGES-BEGIN\n(.*?)\nVMCTL-PACKAGES-END", text, re.S)
        # Fedora's names carry uppercase (NetworkManager, ModemManager) and Arch's an
        # underscore, so the name regex is not Debian's any more; the guest has already
        # normalised pacman's "name version" to names (pkg_manifest) [recon2/pkg-rpm].
        pkgs = [l for l in (m[1].splitlines() if m else [])
                if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+._:-]*", l)]
        pkgs = sorted(set(pkgs))
        n = re.search(r"vmctl-build: (\d+) packages installed", text)
        if len(pkgs) < 200 or not n or int(n[1]) != len(pkgs):
            raise Fail(f"build {flavor}: package list from serial looks wrong "
                       f"({len(pkgs)} entries parsed, guest reported {n[1] if n else '?'})")
        golden.unlink(missing_ok=True)
        shutil.move(str(disk), str(golden))
        (GOLDEN / f"{flavor}-packages.txt").write_text("\n".join(pkgs) + "\n")
        shutil.copy(serial, GOLDEN / f"{flavor}.build.log")
        ok = True
    finally:
        if ok and not a.keep:
            shutil.rmtree(bdir, ignore_errors=True)
    mins = (time.monotonic() - t0) / 60
    log(f"build {flavor}: done in {mins:.1f} min -> {golden} ({len(pkgs)} packages listed in "
        f"{GOLDEN / (flavor + '-packages.txt')})")
    print(golden)


# ---------------------------------------------------------------- start / stop

def start_dbus(inst):
    """Private session bus for QEMU's dbus display. Returns when the socket exists."""
    need_tools("dbus-daemon")
    old = read_pid(inst.dbus_pid)
    if old and pid_alive(old, "dbus-daemon"):
        kill_pid(old)
    inst.bus.unlink(missing_ok=True)
    inst.dbus_pid.unlink(missing_ok=True)
    p = run(["dbus-daemon", "--session", "--fork", "--nopidfile", "--print-pid=1",
             f"--address=unix:path={inst.bus}"])
    try:
        pid = int(p.stdout.strip())
    except ValueError:
        raise Fail(f"dbus-daemon printed no pid: {p.stdout!r}")
    inst.dbus_pid.write_text(f"{pid}\n")
    for _ in range(50):
        if inst.bus.exists() and pid_alive(pid, "dbus-daemon"):
            return
        time.sleep(0.1)
    raise Fail(f"dbus-daemon did not create {inst.bus}")


def stop_dbus(inst):
    pid = read_pid(inst.dbus_pid)
    if pid and pid_alive(pid, "dbus-daemon"):
        kill_pid(pid)
    inst.dbus_pid.unlink(missing_ok=True)
    inst.bus.unlink(missing_ok=True)


def apply_heads(inst, heads):
    """heads: {idx: 'WxH'|'off'|'default'}; calls SetUIInfo for every non-default entry."""
    for idx in sorted(heads):
        spec = heads[idx]
        if spec == "default":
            continue
        if spec == "off":
            set_ui_info(inst.bus, idx, 0, 0)
        else:
            w, h = parse_size(spec)
            set_ui_info(inst.bus, idx, w, h)


def cmd_start(a):
    need_tools("qemu-system-x86_64", "qemu-img", "cloud-localds", "gdbus", "ssh")
    inst = Instance(a.name)
    if inst.exists() and inst.pid():
        raise Fail(f"instance {inst.name!r} is already running (pid {inst.pid()}, ssh port {inst.port})")
    flavor = a.flavor or inst.meta.get("flavor")
    if not flavor:
        raise Fail("--flavor is required for a new instance")
    if inst.exists() and inst.meta.get("flavor") not in (None, flavor):
        raise Fail(f"instance {inst.name!r} is a {inst.meta['flavor']} instance; "
                   f"use --fresh together with --flavor {flavor}, or destroy it")
    golden = golden_path(flavor)
    if not golden.exists():
        raise Fail(f"no golden image for flavor {flavor!r} ({golden}); run `vmctl build {flavor}` first")
    inst.dir.mkdir(parents=True, exist_ok=True)
    # leftovers from a crashed run
    stop_dbus(inst)
    inst.qmp_sock.unlink(missing_ok=True)

    if a.fresh or not inst.disk.exists():
        inst.disk.unlink(missing_ok=True)
        run(["qemu-img", "create", "-q", "-f", "qcow2", "-F", "qcow2", "-b", str(golden), str(inst.disk)])
        inst.meta["instance_id"] = f"{inst.name}-{secrets.token_hex(4)}"
        inst.meta.pop("heads", None)
        log(f"{inst.name}: new overlay disk on {golden}")
    if a.fresh or not inst.seed.exists() or "instance_id" not in inst.meta:
        inst.meta.setdefault("instance_id", f"{inst.name}-{secrets.token_hex(4)}")
        make_seed(inst.dir, user_data_common(inst.name), inst.meta["instance_id"], inst.name)
    with port_lock():
        if "port" not in inst.meta or not port_free(inst.meta["port"]):
            inst.meta["port"] = alloc_port()
        inst.save()
    mem = parse_mem(a.mem or inst.meta.get("mem", "4G"))
    cpus = a.cpus or inst.meta.get("cpus", 3)
    nheads = a.heads if a.heads is not None else inst.meta.get("nheads", 1)
    if not 1 <= nheads <= MAX_HEADS:
        raise Fail(f"--heads must be 1..{MAX_HEADS}")
    size = a.head_size or DEFAULT_HEAD
    parse_size(size)
    # --heads / --head-size (re)size every head incl. head 0; otherwise a reused
    # instance keeps the sizes it had (old meta.json may still say 0=default).
    saved = inst.heads() if a.heads is None and a.head_size is None else {}
    heads = {}
    for i in range(MAX_HEADS):
        heads[i] = (saved.get(i) if i < nheads and saved.get(i) not in (None, "off") else
                    size if i < nheads else "off")
    desktop = flavor_desktop(flavor)
    inst.meta.update({"name": inst.name, "flavor": flavor, "mem": mem, "cpus": cpus,
                      "nheads": nheads, "heads": {str(k): v for k, v in heads.items()},
                      "golden": str(golden), "desktop": desktop, "session_type": DESKTOPS[desktop]["session"],
                      "started": time.strftime("%Y-%m-%dT%H:%M:%S")})
    inst.save()

    start_dbus(inst)
    inst.serial.unlink(missing_ok=True)
    cmd = qemu_common(mem, cpus, inst.disk, inst.seed, inst.port, inst.serial, inst.qemu_pid, inst.name) + [
        "-device", f"virtio-vga,id={GPU},max_outputs={MAX_HEADS},edid=on",
        "-display", f"dbus,addr=unix:path={inst.bus},p2p=no",
        "-qmp", f"unix:{inst.qmp_sock},server,nowait"]
    inst.meta["qemu_cmd"] = cmd
    inst.save()
    try:
        run(cmd, capture=False)
    except Fail:
        stop_dbus(inst)
        raise
    pid = inst.pid()
    if not pid:
        stop_dbus(inst)
        raise Fail("QEMU exited immediately; check the command line in meta.json")
    log(f"{inst.name}: QEMU pid {pid}, flavor {flavor}, {cpus} vCPU/{mem}, ssh port {inst.port}, "
        f"bus {inst.bus}")
    # Size/plug the heads NOW, before the guest kernel probes virtio-gpu: QEMU keeps
    # the requested state per scanout and reports it (with the matching EDID) on the
    # driver's first GET_DISPLAY_INFO, so the session starts with its final monitor
    # set.  Plugging after ssh-up (2-6 s after gnome-shell starts) raced with
    # gnome-shell's startup: a monitors-changed during the start-up animation left
    # every head a flat #222222 (no top bar / dock / wallpaper) until the next login.
    try:
        wait_consoles(inst)
        apply_heads(inst, heads)
    except Fail:
        kill_pid(pid)
        stop_dbus(inst)
        inst.qemu_pid.unlink(missing_ok=True)
        raise
    active = [f"Virtual-{i + 1}" for i in sorted(heads) if heads[i] != "off"]
    log(f"{inst.name}: heads: " + ", ".join(f"{i}={heads[i]}" for i in sorted(heads) if heads[i] != "off")
        + f"  (guest connectors {', '.join(active)}; set before the guest boots)")
    if a.no_wait:
        print(inst.port)
        return
    t = wait_ssh(inst.port, a.timeout, inst.name)
    log(f"{inst.name}: ssh up after {t:.0f}s")
    print(inst.port)


def cmd_stop(a):
    inst = Instance(a.name).require()
    pid = inst.pid()
    if pid is None:
        stop_dbus(inst)
        inst.qmp_sock.unlink(missing_ok=True)
        log(f"{inst.name}: not running")
        return
    # GNOME's session inhibits logind's power-key handling, so an ACPI power
    # button (QMP system_powerdown) only pops up a dialog in a logged-in desktop.
    # Ask the guest over ssh first, then fall back to the ACPI button, then kill.
    p = run(ssh_cmd(inst.port, 3) + ["systemctl", "poweroff"], check=False, timeout=15)
    if p.returncode != 0:
        log(f"{inst.name}: ssh poweroff failed; sending ACPI power button")
        try:
            qmp(inst.qmp_sock, "system_powerdown")
        except Fail as e:
            log(f"{inst.name}: {e}")
    t0 = time.monotonic()
    while time.monotonic() - t0 < a.timeout:
        if not pid_alive(pid):
            break
        time.sleep(0.5)
    if pid_alive(pid):
        log(f"{inst.name}: guest did not power off within {a.timeout}s; quitting QEMU")
        try:
            qmp(inst.qmp_sock, "quit", timeout=5)
        except Fail:
            pass
        kill_pid(pid)
    stop_dbus(inst)
    inst.qemu_pid.unlink(missing_ok=True)
    inst.qmp_sock.unlink(missing_ok=True)
    log(f"{inst.name}: stopped")


def cmd_destroy(a):
    inst = Instance(a.name)
    if not inst.dir.exists():
        raise Fail(f"no instance {inst.name!r}")
    if inst.exists() and inst.pid():
        a.timeout = 60
        cmd_stop(a)
    else:
        stop_dbus(inst)
    shutil.rmtree(inst.dir)
    log(f"{inst.name}: destroyed ({inst.dir})")


def cmd_flavors(a):
    """Every vm/flavors/*.yaml with the headers that decide how it is built.

    The build kind is the header that is there: `# vmctl-base:` (a cloud image and
    `vmctl build`), `# vmctl-iso:` (vm/build-iso-golden.sh) or `# vmctl-nix:`
    (vm/build-nixos-golden.sh)."""
    rows = []
    for f in sorted(FLAVORS.glob("*.yaml")):
        name = f.stem
        kind = ("nix:" + flavor_nix(name) if flavor_nix(name)
                else "iso:" + flavor_iso(name) if flavor_iso(name)
                else "base:" + (flavor_header(name, "base") or "?"))
        rows.append((name, flavor_distro(name), flavor_desktop(name), flavor_ci(name), kind))
    hdr = ("FLAVOR", "DISTRO", "DESKTOP", "CI", "BUILT FROM")
    widths = [max(len(r[i]) for r in rows + [hdr]) for i in range(len(hdr))]
    for r in [hdr] + rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())


def cmd_list(a):
    rows = []
    for meta in sorted(INSTANCES.glob("*/meta.json")):
        inst = Instance(meta.parent.name)
        pid = inst.pid()
        rows.append((inst.name, inst.meta.get("flavor", "?"), "running" if pid else "stopped",
                     str(pid or "-"), str(inst.meta.get("port", "-")),
                     ",".join(f"{i}={v}" for i, v in sorted(inst.heads().items()) if v != "off")))
    for meta in sorted(BUILDS.glob("*/meta.json")):
        pid = read_pid(meta.parent / "qemu.pid")
        rows.append((f"(build) {meta.parent.name}", meta.parent.name,
                     "building" if pid and pid_alive(pid) else "stale", str(pid or "-"),
                     str(json.loads(meta.read_text()).get("port", "-")), ""))
    if not rows:
        log(f"no instances under {INSTANCES}")
        return
    hdr = ("NAME", "FLAVOR", "STATE", "PID", "SSH", "HEADS")
    widths = [max(len(r[i]) for r in rows + [hdr]) for i in range(len(hdr))]
    for r in [hdr] + rows:
        print("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())


def cmd_status(a):
    inst = Instance(a.name).require()
    pid = inst.pid()
    print(f"name:      {inst.name}")
    print(f"flavor:    {inst.meta.get('flavor')}  (golden {inst.meta.get('golden')})")
    d = DESKTOPS[inst.desktop()]
    print(f"desktop:   {inst.desktop()}  ({d['label']}; session type {d['session']}, "
          f"logind Type {'/'.join(d['logind'])}, display manager {d['dm']})")
    print(f"state:     {'running (pid %d)' % pid if pid else 'stopped'}")
    print(f"resources: {inst.meta.get('cpus')} vCPU / {inst.meta.get('mem')}")
    print(f"ssh:       root@127.0.0.1 port {inst.meta.get('port')}  (key {root_key()})")
    print(f"dir:       {inst.dir}")
    print(f"bus:       {inst.bus}   qmp: {inst.qmp_sock}")
    heads = inst.heads()
    print(f"heads:     " + "  ".join(f"{i}={v}" for i, v in sorted(heads.items())))
    if pid:
        for idx in list_consoles(inst.bus):
            pr = console_props(inst.bus, idx) or {}
            size = f"{pr.get('Width')}x{pr.get('Height')}"
            state = heads.get(idx, "off" if idx else "default")
            if state == "off":
                # QEMU's Console keeps the surface of the last scanout, so its
                # Width/Height do not tell that the head is unplugged
                what = f"unplugged (Virtual-{idx + 1} disconnected; QEMU console still holds a {size} surface)"
            else:
                what = f"{size}  (guest connector Virtual-{idx + 1}" + \
                       (", QEMU default EDID)" if state == "default" else ")")
            print(f"  Console_{idx}: label={pr.get('Label')} head={pr.get('Head')} {what}")


# ---------------------------------------------------------------- guest access

def cmd_ssh(a):
    inst = Instance(a.name).require_running()
    # ssh joins the words of a remote command with spaces and the guest's shell
    # re-splits them, so a multi-word command has to be quoted here: without it
    # `-- sh -c 'a; b'` reaches the guest as three words and runs `sh -c a`.
    # A single word is handed over untouched -- that is the ssh convention for
    # passing a whole command line ("a | b") to the remote shell.
    cmd = list(a.cmd)
    if len(cmd) > 1:
        cmd = [shlex.join(cmd)]
    os.execvp("ssh", ssh_cmd(inst.port, 5, tty=False) + cmd)


def cmd_scp(a):
    inst = Instance(a.name).require_running()
    args = []
    for x in a.args:
        if x.startswith(f"{inst.name}:"):
            x = "root@127.0.0.1:" + x[len(inst.name) + 1:]
        args.append(x)
