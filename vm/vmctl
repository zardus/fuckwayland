X11_DROP_SCRIPT = r"""
# @OUT@ has just been unplugged.  The DRM connector goes away, but RandR keeps
# the output's CRTC -- with its mode and position -- until something disables
# it, so `xrandr --listmonitors` still reports a monitor that is not there.
# The desktop's display daemon normally does it; Xfce 4.20's has been seen
# sitting on a removed output for over a minute.  Give it a few seconds, then
# disable the output here.
st=connected
for _ in 1 2 3 4 5; do
  line=$(xrandr --query 2>/dev/null | sed -n 's/^@OUT@ //p' | head -1)
  case "$line" in
    "")                   echo unknown-output; exit 0 ;;   # no such output (or no X)
    disconnected\ [0-9]*)  st=stuck ;;                      # gone, but X still scans it out
    disconnected*)        echo released; exit 0 ;;         # X let go of it
    *)                    st=connected ;;                  # X has not seen the unplug yet
  esac
  sleep 1
done
[ "$st" = stuck ] || { echo "$st"; exit 0; }
xrandr --output @OUT@ --off >/dev/null 2>&1 && echo disabled || echo disable-failed
"""


def drop_x11_output(inst, idx):
    """Best-effort: after unplugging head `idx`, make the X server let go of the
    output (see X11_DROP_SCRIPT).  Never fails the command -- the session may not
    be up yet, and on a Wayland flavor this is not called at all."""
    out = f"Virtual-{idx + 1}"
    try:
        p = user_shell(inst, X11_DROP_SCRIPT.replace("@OUT@", out), timeout=45)
    except Fail as e:
        log(f"{inst.name}: could not reach the X session to release {out}: {e}")
        return
    state = (p.stdout.strip().splitlines() or [""])[-1] if p.returncode == 0 else "unreachable"
    if state == "disabled":
        log(f"{inst.name}: {out} was still enabled in the X server after the unplug; "
            f"disabled it (xrandr --output {out} --off)")
    elif state in ("connected", "disable-failed", "unreachable"):
        log(f"{inst.name}: warning: the X server still holds {out} ({state})")


