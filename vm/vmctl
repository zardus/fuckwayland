def dm_units(desktop):
    """The display-manager units to name in the "the session never came up" hint.

    Every candidate of the DESKTOPS row plus display-manager.service, which is the
    unit NixOS drives and the alias every distribution's DM carries."""
    return tuple(DESKTOPS[desktop]["dm"]) + ("display-manager",)


DEFAULT_HEAD = "1920x1080"        # size of heads 0..N-1 for `start --heads N` (override: --head-size)
GPU = "gpu0"
BUS_NAME = "org.qemu"             # what QEMU 8.2's dbus display owns (not org.qemu.Display1)
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,40}$")


class Fail(Exception):
    """A user-facing error; printed as `vmctl: <msg>` with exit status 1."""


def log(msg):
    print(f"vmctl: {msg}", file=sys.stderr, flush=True)


def run(cmd, check=True, capture=True, timeout=None, input=None):
    """subprocess.run wrapper that turns failures into Fail with the command shown."""
    try:
        p = subprocess.run(cmd, check=False, text=True, input=input, timeout=timeout,
                           stdout=subprocess.PIPE if capture else None,
                           stderr=subprocess.PIPE if capture else None)
    except FileNotFoundError:
        raise Fail(f"required tool not found: {cmd[0]}")
    except subprocess.TimeoutExpired:
        raise Fail(f"timed out after {timeout}s: {shlex.join(cmd)}")
    if check and p.returncode != 0:
        err = (p.stderr or "").strip() if capture else ""
        raise Fail(f"command failed ({p.returncode}): {shlex.join(cmd)}" + (f"\n{err}" if err else ""))
    return p


def need_tools(*tools):
    missing = [t for t in tools if shutil.which(t) is None]
    if missing:
        raise Fail("missing host tools: " + ", ".join(missing))


def parse_size(s):
    m = re.fullmatch(r"(\d{2,5})x(\d{2,5})", s)
    if not m:
        raise Fail(f"bad size {s!r}; want WIDTHxHEIGHT, e.g. 1920x1080")
    return int(m[1]), int(m[2])


def parse_mem(s):
    """Validate a QEMU -m argument like 4G / 4096M / 4096."""
    if not re.fullmatch(r"\d+[GgMm]?", s):
        raise Fail(f"bad memory size {s!r}; want e.g. 4G or 4096M")
    return s


def check_name(name):
    if not NAME_RE.match(name):
        raise Fail(f"bad instance name {name!r} (letters, digits, . _ -; max 41 chars)")
    return name


def pid_alive(pid, must_contain="qemu-system"):
    """True if pid exists and its cmdline contains must_contain (stale-pidfile guard)."""
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return False
    return must_contain.encode() in cmdline


def read_pid(path):
    try:
        return int(Path(path).read_text().strip())
    except (OSError, ValueError):
        return None


def kill_pid(pid, grace=5.0):
    """SIGTERM, then SIGKILL after `grace` seconds."""
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    t0 = time.monotonic()
    while time.monotonic() - t0 < grace:
        if not Path(f"/proc/{pid}").exists():
            return
        time.sleep(0.2)
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def port_free(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind(("127.0.0.1", port))
            return True
        except OSError:
            return False


def ports_in_use():
    used = set()
    for meta in list(INSTANCES.glob("*/meta.json")) + list(BUILDS.glob("*/meta.json")):
        try:
            used.add(int(json.loads(meta.read_text()).get("port", 0)))
        except (OSError, ValueError):
            pass
    return used


@contextlib.contextmanager
def port_lock():
    """Serialises port allocation + reservation (meta.json) across concurrent vmctl runs."""
    VMDATA.mkdir(parents=True, exist_ok=True)
    with open(VMDATA / ".ports.lock", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def alloc_port():
    """Next ssh port not reserved by any instance/build meta.json and not bound.
    Call inside port_lock() and write the reservation before leaving it."""
    used = ports_in_use()
    for p in PORTS:
        if p not in used and port_free(p):
            return p
    raise Fail(f"no free ssh port in {PORTS.start}-{PORTS.stop - 1}")


# ---------------------------------------------------------------- ssh key

def root_key():
    """Path to the guest root private key, generated on first use."""
    KEYS.mkdir(parents=True, exist_ok=True)
    key = KEYS / "id_ed25519"
    if not key.exists():
        need_tools("ssh-keygen")
        # generate under a private name and link it into place atomically, so
        # two concurrent vmctl processes (e.g. parallel builds) share one key
        tmp = KEYS / f".id_ed25519.{os.getpid()}"
        # ssh-keygen writes the public half to "<file>.pub"; pathlib's with_suffix
        # would replace ".<pid>" instead of appending, and name a file that is
        # never written -- the first build on a fresh $VMDATA then died here.
        pub = tmp.parent / (tmp.name + ".pub")
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "vmctl-guest-root", "-f", str(tmp)])
        try:
            os.link(tmp, key)
        except FileExistsError:
            pass
        else:
            os.replace(pub, key.with_suffix(".pub"))
            log(f"generated guest root ssh key {key}")
        tmp.unlink(missing_ok=True)
        pub.unlink(missing_ok=True)
        for _ in range(50):
            if key.with_suffix(".pub").exists():
                break
            time.sleep(0.1)
    return key


def root_pubkey():
    return (root_key().with_suffix(".pub")).read_text().strip()


def ssh_cmd(port, connect_timeout=5, tty=False, extra=()):
    cmd = ["ssh", "-p", str(port), "-i", str(root_key()),
           "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
           "-o", "LogLevel=ERROR", "-o", f"ConnectTimeout={connect_timeout}",
           "-o", "BatchMode=yes", "-o", "ServerAliveInterval=15"]
    if tty:
        cmd.append("-t")
    cmd += list(extra)
    cmd.append("root@127.0.0.1")
    return cmd


def scp_base(port):
    return ["scp", "-P", str(port), "-i", str(root_key()),
            "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
            "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=5", "-o", "BatchMode=yes"]


def ssh_script(port, script, timeout=60, connect_timeout=5):
    """Run a bash script (given as text) as root in the guest; returns CompletedProcess."""
    return run(ssh_cmd(port, connect_timeout) + ["bash", "-s"], check=False,
               input=script, timeout=timeout)


def wait_ssh(port, timeout, what="guest"):
    t0 = time.monotonic()
    while True:
        p = run(ssh_cmd(port, 5) + ["true"], check=False, timeout=20)
        if p.returncode == 0:
            return time.monotonic() - t0
        if time.monotonic() - t0 > timeout:
            raise Fail(f"{what}: ssh on 127.0.0.1:{port} did not come up within {timeout}s")
        time.sleep(2)


# ---------------------------------------------------------------- QMP / D-Bus

def qmp(sock_path, command, arguments=None, timeout=15):
    """Execute one QMP command over the unix socket; returns the `return` value."""
    sock_path = Path(sock_path)
    if not sock_path.exists():
        raise Fail(f"QMP socket {sock_path} missing -- is the VM running?")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(str(sock_path))
    except OSError as e:
        raise Fail(f"cannot connect to QMP socket {sock_path}: {e}")
    f = s.makefile("rb")

    def send(obj):
        s.sendall((json.dumps(obj) + "\n").encode())

    def reply():
        while True:
            line = f.readline()
            if not line:
                raise Fail("QMP connection closed")
            msg = json.loads(line)
            if "return" in msg or "error" in msg:
                return msg
            # events and the greeting are skipped

    try:
        greeting = json.loads(f.readline() or b"{}")
        if "QMP" not in greeting:
            raise Fail("unexpected QMP greeting")
        send({"execute": "qmp_capabilities"})
        reply()
        send({"execute": command, "arguments": arguments or {}})
        r = reply()
        if "error" in r:
            raise Fail(f"QMP {command}: {r['error'].get('desc', r['error'])}")
        return r["return"]
    except socket.timeout:
        raise Fail(f"QMP {command}: timed out after {timeout}s")
    finally:
        s.close()


def gdbus(bus, *args, timeout=15):
    need_tools("gdbus")
    return run(["gdbus"] + list(args[:1]) + ["--address", f"unix:path={bus}", "--dest", BUS_NAME]
               + list(args[1:]), timeout=timeout)


def console_path(idx):
    return f"/org/qemu/Display1/Console_{idx}"


def set_ui_info(bus, idx, width, height):
    """SetUIInfo(width_mm, height_mm, xoff, yoff, width, height) on head idx.
    width=height=0 unplugs the head (head 0 cannot be unplugged, only resized)."""
    gdbus(bus, "call", "--object-path", console_path(idx),
          "--method", "org.qemu.Display1.Console.SetUIInfo",
          "0", "0", "0", "0", str(width), str(height))


def console_props(bus, idx):
    """{'Label': 'gpu0.1', 'Head': 1, 'Width': 1920, 'Height': 1080, ...} or None."""
    p = run(["gdbus", "call", "--address", f"unix:path={bus}", "--dest", BUS_NAME,
             "--object-path", console_path(idx), "--method",
             "org.freedesktop.DBus.Properties.GetAll", "org.qemu.Display1.Console"],
            check=False, timeout=15)
    if p.returncode != 0:
        return None
    props = {}
    for k, v in re.findall(r"'(\w+)': <(?:uint32 |int32 )?'?([^'>,]*)'?>", p.stdout):
        props[k] = int(v) if v.isdigit() else v
    return props


def list_consoles(bus):
    p = run(["gdbus", "introspect", "--address", f"unix:path={bus}", "--dest", BUS_NAME,
             "--object-path", "/org/qemu/Display1"], check=False, timeout=15)
    if p.returncode != 0:
        return []
    return sorted(int(n) for n in re.findall(r"node Console_(\d+)", p.stdout))


def wait_consoles(inst, timeout=20):
    """Block until QEMU owns org.qemu on the instance bus and exports Console_0.
    `-daemonize` returns after the display is initialised, but the bus name is
    acquired asynchronously from QEMU's main loop, so poll briefly."""
    t0 = time.monotonic()
    while True:
        if 0 in list_consoles(inst.bus):
            return time.monotonic() - t0
        if inst.pid() is None:
            raise Fail(f"{inst.name}: QEMU exited while starting; see {inst.serial} and meta.json")
        if time.monotonic() - t0 > timeout:
            raise Fail(f"{inst.name}: QEMU did not export /org/qemu/Display1/Console_0 on {inst.bus} "
                       f"within {timeout}s")
        time.sleep(0.2)


# ---------------------------------------------------------------- instances

class Instance:
    def __init__(self, name):
        self.name = check_name(name)
        self.dir = INSTANCES / name
        self.disk = self.dir / "disk.qcow2"
        self.seed = self.dir / "seed.img"
        self.qmp_sock = self.dir / "qmp.sock"
        self.bus = self.dir / "bus"
        self.dbus_pid = self.dir / "dbus.pid"
        self.qemu_pid = self.dir / "qemu.pid"
        self.serial = self.dir / "serial.log"
        self.meta_path = self.dir / "meta.json"
        self.meta = {}
        if self.meta_path.exists():
            try:
                self.meta = json.loads(self.meta_path.read_text())
            except ValueError as e:
                raise Fail(f"{self.meta_path}: corrupt: {e}")

    def exists(self):
        return self.meta_path.exists()

    def require(self):
        if not self.exists():
            raise Fail(f"no instance {self.name!r} (see `vmctl list`; create with `vmctl start`)")
        return self

    def save(self):
        self.dir.mkdir(parents=True, exist_ok=True)
        tmp = self.meta_path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.meta, indent=2, sort_keys=True) + "\n")
        tmp.replace(self.meta_path)

    @property
    def port(self):
        return int(self.meta["port"])

    def pid(self):
        """Live QEMU pid or None (removes a stale pidfile)."""
        pid = read_pid(self.qemu_pid)
        if pid and pid_alive(pid):
            return pid
        if self.qemu_pid.exists():
            log(f"{self.name}: removing stale pidfile {self.qemu_pid}")
            self.qemu_pid.unlink(missing_ok=True)
        return None

    def require_running(self):
        self.require()
        if self.pid() is None:
            raise Fail(f"instance {self.name!r} is not running (start it with `vmctl start {self.name}`)")
        return self

    def heads(self):
        """{idx: 'WxH' | 'default' | 'off'} as last applied by vmctl."""
        return {int(k): v for k, v in self.meta.get("heads", {"0": "default"}).items()}

    def active_heads(self):
        return sorted(i for i, v in self.heads().items() if v != "off")

    def desktop(self):
        """gnome|kde|kde-x11|xfce|sway: from meta.json (recorded by `start`), else the flavor yaml."""
        d = self.meta.get("desktop")
        if d in DESKTOPS:
            return d
        try:
            return flavor_desktop(self.meta.get("flavor", ""))
        except Fail:
            return "gnome"

    def session_kind(self):
        """wayland|x11: the kind of graphical session the desktop runs."""
        return DESKTOPS[self.desktop()]["session"]


