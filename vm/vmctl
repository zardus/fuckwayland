def paint_env(desktop):
    """The `DESKTOP=... COMP=... SHELLS=... SPLASH=...` prelude of PAINT_SCRIPT."""
    d = DESKTOPS.get(desktop, {})
    return ("DESKTOP={}\nCOMP={}\nSHELLS={}\nSPLASH={}\n".format(
        desktop, d.get("compositor") or "",
        shlex.quote(" ".join(d.get("shell") or ())), d.get("splash") or ""))


PAINT_MIN_STDDEV = 0.02   # below this a head is one flat colour and nothing has been
                          # painted on it yet (selftest.sh fails a screendump under
                          # 0.01; a desktop that is up measures 0.05 and more)


def _ppm_stddev(data):
    """Standard deviation (0..1) of the pixels of a binary PPM, over a sample of
    its bytes; None if the data is not a P6 PPM with 8-bit channels."""
    if not data.startswith(b"P6"):
        return None
    pos, fields = 2, []
    while len(fields) < 3 and pos < len(data):
        c = data[pos:pos + 1]
        if c.isspace():
            pos += 1
        elif c == b"#":
            while pos < len(data) and data[pos:pos + 1] not in (b"\n", b"\r"):
                pos += 1
        else:
            start = pos
            while pos < len(data) and not data[pos:pos + 1].isspace():
                pos += 1
            try:
                fields.append(int(data[start:pos]))
            except ValueError:
                return None
    if len(fields) != 3 or fields[2] != 255 or pos >= len(data):
        return None
    pix = data[pos + 1:fields[0] * fields[1] * 3 + pos + 1]
    if not pix:
        return None
    stride = max(1, len(pix) // 30000)
    if stride % 3 == 0:            # keep the sample from landing on one channel
        stride += 1
    vals = pix[::stride]
    mean = sum(vals) / len(vals)
    return (sum((v - mean) ** 2 for v in vals) / len(vals)) ** 0.5 / 255.0


def _flat_heads(inst):
    """The active heads whose screendump is (near enough) a single flat colour.
    Empty when every head carries a picture -- and also when QEMU cannot write a
    PPM, in which case the caller simply gets the guest-side verdict."""
    flat = []
    for idx in inst.active_heads():
        with tempfile.NamedTemporaryFile(suffix=".ppm", delete=False) as f:
            path = Path(f.name)
        try:
            qmp(inst.qmp_sock, "screendump",
                {"filename": str(path), "device": GPU, "head": idx, "format": "ppm"}, timeout=30)
            sd = _ppm_stddev(path.read_bytes())
        except Exception:
            sd = None
        finally:
            path.unlink(missing_ok=True)
        if sd is not None and sd < PAINT_MIN_STDDEV:
            flat.append(idx)
    return flat


def _shot_md5(inst, idx):
    """md5 of a screendump of head idx (None if the dump fails)."""
    import hashlib
    with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as f:
        path = Path(f.name)
    try:
        qmp(inst.qmp_sock, "screendump",
            {"filename": str(path), "device": GPU, "head": idx, "format": "png"}, timeout=30)
        return hashlib.md5(path.read_bytes()).hexdigest()
    except Exception:
        return None
    finally:
        try:
            path.unlink()
        except OSError:
            pass


def wait_first_paint(inst, before=None, timeout=60):
    """Block until the desktop has drawn its first frame on *every* head: GNOME's
    "GNOME Shell started" journal line; other desktops: the compositor owns head
    0's scanout framebuffer (DRM debugfs) and the shell/panel processes are up
    with no splash screen left -- or, when the guest offers nothing to go by,
    head 0's screendump differs from `before` (its md5 from before the session
    came up).  All of those look at head 0 alone, and a secondary head can lag it
    by seconds (Xfce paints its panel first and xfdesktop's wallpaper per monitor
    afterwards), so the guest's verdict is confirmed against the pixels: no head
    may still be one flat colour.  Returns the seconds waited (None on timeout)."""
    t0 = time.monotonic()
    desktop = inst.desktop()
    last = ""
    while time.monotonic() - t0 < timeout:
        p = ssh_script(inst.port, paint_env(desktop) + PAINT_SCRIPT, timeout=30)
        verdict = (p.stdout.strip().splitlines() or [""])[-1] if p.returncode == 0 else "WAIT ssh"
        if verdict == "UNKNOWN":
            now = _shot_md5(inst, 0)
            if now and before and now != before:
                verdict = "PAINTED"
        if verdict == "PAINTED":
            flat = _flat_heads(inst)
            if not flat:
                return time.monotonic() - t0
            verdict = "WAIT flat head " + ",".join(str(i) for i in flat)
        if verdict != last:
            log(f"{inst.name}: waiting for the first frame: {verdict}")
            last = verdict
        time.sleep(1.5)
    return None


def cmd_session(a):
    inst = Instance(a.name).require_running()
    kind, desktop = inst.session_kind(), inst.desktop()
    t0 = time.monotonic()
    last = ""
    before = None if getattr(a, "no_paint", False) else _shot_md5(inst, 0)
    while True:
        p = ssh_script(inst.port, f"DESKTOP={desktop}\nKIND={kind}\n" + SESSION_SCRIPT, timeout=30)
        line = (p.stdout.strip().splitlines() or [""])[-1] if p.returncode == 0 else "ssh: " + p.stderr.strip()
        partial = [l for l in p.stdout.splitlines() if l.startswith("PARTIAL")]
        if line.startswith("OK "):
            words = line.split()
            sid = words[1]
            found = dict(w.split("=", 1) for w in words[2:] if "=" in w)
            print(f"SESSION_ID={sid}")
            print("XDG_RUNTIME_DIR=/run/user/1000")
            # $hy is a readiness signal only: Hyprland exports the variable that names
            # its socket (HYPRLAND_INSTANCE_SIGNATURE) into the systemd user manager
            # itself, which is where USER_WRAPPER picks it up [recon2/hyprland].
            for k in ("WAYLAND_DISPLAY", "DISPLAY", "SWAYSOCK", "WAYFIRE_SOCKET"):
                if k in found:
                    print(f"{k}={found[k]}")
            print("DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus")
            print(f"XDG_SESSION_TYPE={kind}")
            log(f"{inst.name}: {kind} session {sid} of user test ({desktop}) active after {time.monotonic() - t0:.0f}s")
            if not getattr(a, "no_paint", False):
                waited = wait_first_paint(inst, before)
                if waited is None:
                    log(f"{inst.name}: warning: no first frame detected within 60s; continuing")
                else:
                    log(f"{inst.name}: desktop painted its first frame {waited:.0f}s later")
            return
        state = partial[-1] if partial else line
        if state != last:
            log(f"{inst.name}: waiting for the {kind} session of user test ({desktop}): {state}")
            last = state
        if time.monotonic() - t0 > a.timeout:
            units = " ".join(f"-u {u}" for u in dm_units(desktop))
            raise Fail(f"{inst.name}: no active {kind} session for user test within {a.timeout}s "
                       f"(last: {state}); check `vmctl ssh {inst.name} -- journalctl -b {units}`")
        time.sleep(3)


USER_WRAPPER = r"""
# VMCTL_DESKTOP=gnome|kde|kde-x11|xfce|sway and VMCTL_SESSION=wayland|x11 come from the host.
# Session variables are imported first-wins, in this order: what the session
# exported to the systemd user manager (gnome-session, startplasma, the X
# session's dbus-update-activation-environment, sway's exec line), then the
# compositor's / session leader's own environment, then the sockets that are
# actually there.
imp() {   # import plain-valued session variables from "K=V" words, never overriding
  for kv in "$@"; do
    case "$kv" in
      XAUTHORITY=*|DISPLAY=*|WAYLAND_DISPLAY=*|SWAYSOCK=*|I3SOCK=*|\
      HYPRLAND_INSTANCE_SIGNATURE=*|WAYFIRE_SOCKET=*|XDG_CURRENT_DESKTOP=*|\
      XDG_SESSION_DESKTOP=*|DESKTOP_SESSION=*|XDG_SESSION_ID=*|XDG_SESSION_TYPE=*)
