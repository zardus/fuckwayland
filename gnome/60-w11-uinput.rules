# w11: let the active seat user open /dev/uinput (wdotool's input
# injection) without root, groups or a relogin.
#
# - static_node=uinput: udev creates /dev/uinput at boot from the module's
#   devname alias even while the uinput module is not loaded (opening it
#   autoloads the module), and applies the tag to that static node.
# - TAG+="uaccess": systemd-logind puts an ACL for the user of the active
#   session on the node at every session activation (login, VT switch),
#   and `udevadm trigger --name-match=uinput` re-applies it right away.
#
# Deliberately no MODE/GROUP: the node stays root:root 0600 plus that ACL,
# so only the user at the seat can inject input. A MODE="0660" GROUP="input"
# fallback would hand every member of `input` (service accounts included) a
# standing keystroke-injection channel into the seat user's session, whether
# or not they are logged in there. Sessions logind does not manage (ssh +
# sudo -u, containers) run the tools as root instead.
#
# Installed by gnome/install-bridge.sh --udev to /etc/udev/rules.d/, together
# with /etc/modules-load.d/w11-uinput.conf.
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess"
