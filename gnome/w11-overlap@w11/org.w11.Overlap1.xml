<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- org.w11.Overlap1, on org.w11.Overlap at /org/w11/Overlap.

     Two methods, both taking and returning a JSON string, and both doing
     nothing whatever until they are called.  Probe reads and reports; only
     ApplyOverlap writes, and only after Probe's checks have all passed again.

     Also embedded in extension.js -- this copy is for reading. -->
<node>
  <interface name="org.w11.Overlap1">

    <!-- Run every check against the running libmutter and report.  Writes
         nothing except a sentinel into a throwaway configuration object of its
         own making.  Request: {"layout_mode": 1|2, "expect": [...]} , both
         optional; layout_mode is DisplayConfig's, and is checked against the
         value read at the offset this build believes.  Reply: the JSON below
         with "wrote": false. -->
    <method name="Probe">
      <arg type="s" name="request" direction="in"/>
      <arg type="s" name="result" direction="out"/>
    </method>

    <!-- Move logical monitors to positions Mutter's validator refuses.
         Request:
           {"layout_mode": 1,
            "expect": [{"connectors": ["Virtual-1"], "x": 0,   "y": 0}, ...],
            "want":   [{"connectors": ["Virtual-1"], "x": 0,   "y": 0}, ...]}
         "expect" is the layout the caller believes is running and must match
         what is read out of the compositor exactly; "want" must name the same
         monitors and must describe a layout Mutter refuses (anything else
         belongs on the ordinary DisplayConfig path).
         Reply:
           {"ok": true, "version": 1, "shell": "50.1", "libmutter": 18,
            "checks": [{"name": ..., "ok": true, "detail": ...}, ...],
            "monitors": [{"connectors": [...], "x": ..., "y": ..., ...}, ...],
            "wrote": true, "applied": true, "wrote_words": 4,
            "fault": "logical monitors overlap",
            "verify": "refused: Logical monitors not adjacent",
            "public": [...],
            "saved_config": {"path": ..., "before": ..., "after": ...,
                             "unchanged": true}}
         or {"ok": false, "check": "...", "reason": "..."} for every refusal.
         A refusal after the write puts the words back before it returns. -->
    <method name="ApplyOverlap">
      <arg type="s" name="request" direction="in"/>
      <arg type="s" name="result" direction="out"/>
    </method>

    <property name="Version" type="u" access="read"/>
  </interface>
</node>
